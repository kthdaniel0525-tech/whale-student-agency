# Run npm run setup:local to generate random local values automatically.
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql://student:replace-with-local-database-password@localhost:5439/student_agency
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Remote production origins must use HTTPS.
# Private filesystem storage and cached local embeddings; no provider API key required.
DOCUMENT_STORAGE_PATH=.local/documents
EMBEDDING_CACHE_PATH=.local/models
RAG_MIN_SIMILARITY=0.35
# Model downloads are disabled during normal operation.
# npm run embeddings:prepare enables downloads only for its setup process.

# PostgreSQL-backed background jobs. The worker creates/migrates this schema.
BACKGROUND_JOB_SCHEMA=student_jobs
BACKGROUND_JOB_WORKER_CONCURRENCY=4
# Production defaults to enabled; development/test default to disabled.
# BACKGROUND_JOB_SCHEDULE_ENABLED=true
RECOMMENDATION_REFRESH_CRON=0 5 * * *
RECOMMENDATION_REFRESH_PAGE_SIZE=200
RECOMMENDATION_REFRESH_FANOUT_CONCURRENCY=10

# Optional server-side OpenAI generation. Existing local RAG needs none of these.
# OPENAI_API_KEY=your-server-side-key
# AI_CHAT_MODEL=gpt-4.1-mini
# Optional full replacement of server-side model prices; no migration required.
# AI_MODEL_PRICING_JSON={"version":"custom-2026-09","models":[{"provider":"openai","model":"gpt-4.1-mini","inputPerMillion":0.4,"cachedInputPerMillion":0.1,"outputPerMillion":1.6}]}
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=1536
# AI_TEMPERATURE=0.2
# AI_MAX_OUTPUT_TOKENS=2048
# AI_TIMEOUT_MS=30000
# AI_REASONING_TIMEOUT_MS=180000
# Optional full replacement of the server-only catalog. See docs/model-routing.md.
# AI_MODEL_CATALOG_JSON=[...]
# Dev/test or explicitly controlled evaluations only (never a frontend parameter).
# AI_ROUTING_OVERRIDE_JSON={"tier":"STRONG"}
# AI_ROUTING_EVALUATION_MODE=false
# Provider fallback/circuit/timeouts, server-only; see docs/ai-reliability.md.
# AI_RELIABILITY_JSON={"disabledProviders":[],"interactive":{"maxAttempts":2},"timeouts":{"routing":15000,"text":60000},"breaker":{"consecutiveFailures":3}}
# Optional server-only safety policy overrides (same defaults in dev/production).
# See docs/ai-guardrails.md. Requires the AI guardrails database migration.
# AI_GUARDRAILS_JSON={"disableBackgroundAI":false,"disabledFeatures":[],"profiles":{"STANDARD":{"maxAICalls":8}},"concurrency":{"user":4}}

# In-app delivery sweep (production schedule; opt in locally with BACKGROUND_JOB_SCHEDULE_ENABLED)
NOTIFICATION_DELIVERY_CRON="*/5 * * * *"

# Optional external account connections (server-only, separate from app sign-in).
# GOOGLE_INTEGRATION_CLIENT_ID=
# GOOGLE_INTEGRATION_CLIENT_SECRET=
# Must match BETTER_AUTH_URL origin; register /api/student/integrations/google/callback.
# INTEGRATION_OAUTH_BASE_URL=http://localhost:3000
# JSON map of key IDs to independent random 32-byte keys encoded as standard base64.
# Generate a key locally with: node -e 'process.stdout.write(require("crypto").randomBytes(32).toString("base64"))'
# Store actual keys in your secret manager; retain old IDs while rotating ciphertext.
# INTEGRATION_TOKEN_KEYS='{"v1":"<base64-encoded-32-byte-key>"}'
# INTEGRATION_TOKEN_ACTIVE_KEY_ID=v1

# Optional LMS course-sync cadence. No production LMS adapter is installed in this phase.
# ACADEMIC_SYNC_MINUTES=180
# ACADEMIC_FILE_SYNC_HOURS=24
# ACADEMIC_SYNC_CRON="23 * * * *"

# Optional content evaluation. Disabled unless a reviewed product/privacy policy
# is configured AND the authenticated user opts into this exact policy version.
AI_EVAL_SAMPLING_ENABLED=false
AI_EVAL_SAMPLE_RATE=0.01
AI_EVAL_POLICY_VERSION=
AI_EVAL_POLICY_URL=
# Optional per-profile thresholds: minimum, allowedDrop, minimumSamples.
AI_EVAL_THRESHOLDS_JSON=

# Product access, separate from safety guardrails. No payment provider required.
DEFAULT_PLAN_CODE=free
# Optional global capability vetoes, e.g. {"integration.calendar":false}.
ENTITLEMENT_FEATURE_FLAGS_JSON={}

# Stripe subscriptions are disabled until provider configuration is complete.
BILLING_ENABLED=false
# Pause new checkout while keeping portal access, cancellation and webhooks active.
BILLING_CHECKOUT_ENABLED=true
# Explicit deployment boundary: development / staging / production. Production requires live mode.
BILLING_ENVIRONMENT=development
BILLING_MODE=test
BILLING_CURRENCY=usd
BILLING_GRACE_DAYS=3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# One Stripe Product with monthly/yearly fixed prices. Keep retired mappings with enabled:false.
BILLING_PRICES_JSON={"student":{"monthly":"price_REPLACE_STUDENT","enabled":true},"pro":{"monthly":"price_REPLACE_PRO","enabled":true}}

# Account deletion retains no billing mapping unless the operator explicitly sets
# a retention policy. Required before deleting an account with a billing customer.
# 0 means delete local billing mappings; provider financial retention is separate.
PRIVACY_BILLING_RETENTION_DAYS=

# Operations: production/staging use deploy/runtime.env.example and Compose secrets.
APP_ENV=development
DATABASE_POOL_MAX=8
LOG_LEVEL=info
# APP_URL must match BETTER_AUTH_URL exactly in deployed environments.
# RELEASE_SHA is set in the immutable container image.
# OPERATIONS_TOKEN=<random private health/metrics token, min 32 chars>
# ERROR_MONITORING_ENABLED=true
# SENTRY_DSN=<server-side project DSN>
SIGNUP_ENABLED=true
# SIGNUP_EMAIL_ALLOWLIST=first@example.com,second@example.com

# Closed beta and private product analytics (enable deliberately per environment)
BETA_MODE=false
BETA_DEFAULT_COHORT=core
BETA_ADMIN_USER_IDS=
BETA_INTERNAL_USER_IDS=
# BETA_COHORT_FLAGS_JSON={"core":{"workflow.career-preparation":false}}
PRODUCT_ANALYTICS_ENABLED=false
PRODUCT_ANALYTICS_PROVIDER=database
PRODUCT_ANALYTICS_RETENTION_DAYS=180
# PRODUCT_ACTIVATION_EVENTS_JSON=["onboarding_completed","course_created","ai_request_completed"]
# PRODUCT_MEANINGFUL_EVENTS_JSON=["ai_request_completed","quiz_completed","workflow_completed","study_task_completed"]
