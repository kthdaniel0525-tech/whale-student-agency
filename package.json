{
  "name": "student-agency-foundation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname localhost --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --hostname localhost --port 3000",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern generated --ignore-pattern work",
    "db:generate": "prisma generate",
    "dev:sites": "vinext dev --port 5173",
    "build:sites": "vinext build",
    "start:sites": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "node scripts/docker.mjs compose up -d --wait",
    "db:down": "node scripts/docker.mjs compose stop",
    "db:client": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate:sites": "drizzle-kit generate",
    "test:migration": "node scripts/verify-migration.mjs",
    "documents:worker": "node scripts/document-worker.mjs",
    "jobs:worker": "node --conditions=react-server --import tsx scripts/background-worker.ts",
    "jobs:trigger": "node --conditions=react-server --import tsx scripts/trigger-background-job.ts",
    "embeddings:prepare": "node --conditions=react-server --import tsx scripts/prepare-embeddings.ts",
    "evals": "node --conditions=react-server --import tsx scripts/run-evals.ts",
    "test:evals": "vitest run tests/ai-evaluation.test.ts",
    "plans:sync": "node --conditions=react-server --import tsx scripts/configure-plans.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@huggingface/transformers": "4.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@shadcn/react": "^0.3.0",
    "better-auth": "1.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "openai": "7.15.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "pg-boss": "^12.33.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "7.10.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
