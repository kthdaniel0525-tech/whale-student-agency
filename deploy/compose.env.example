# Public deployment metadata. Keep actual secrets in DEPLOY_SECRETS_DIR only.
COMPOSE_PROJECT_NAME=agency-staging
DEPLOY_ENVIRONMENT=staging
APP_DOMAIN=staging.example.com
ACME_EMAIL=operations@example.com
DEPLOY_SECRETS_DIR=/etc/agency-staging/secrets
# Release automation supplies an immutable registry digest; never use latest.
APP_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_DIGEST
