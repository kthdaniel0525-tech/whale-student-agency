# Staging deployment metadata only. Keep filled files outside the checkout.
COMPOSE_PROJECT_NAME=student-ai-agency-staging
DEPLOY_ENVIRONMENT=staging
APP_DOMAIN=staging.example.com
ACME_EMAIL=operations@example.com
DEPLOY_SECRETS_DIR=/opt/student-ai-agency/secrets
# Pin the exact GHCR digest produced by the reviewed release. Never use latest.
APP_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_WITH_64_HEX_DIGEST

# Existing per-container containment limits. The host needs additional memory
# for Ubuntu, Docker, release jobs, builds, and replacement overlap.
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=2g
DATABASE_CPU_LIMIT=2.0
DATABASE_MEMORY_LIMIT=2g
PROXY_CPU_LIMIT=0.5
PROXY_MEMORY_LIMIT=256m
