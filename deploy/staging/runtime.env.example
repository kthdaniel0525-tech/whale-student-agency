# Copy to /opt/student-ai-agency/secrets/runtime.env and replace placeholders.
# Never commit the filled file. NODE_ENV=production is baked into the image;
# APP_ENV identifies this deployed environment as staging.
APP_ENV=staging
APP_URL=https://staging.example.com
BETTER_AUTH_URL=https://staging.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SECRET
DATABASE_URL=postgresql://agency_app:REPLACE_WITH_APP_DATABASE_PASSWORD@postgres:5432/agency
DATABASE_POOL_MAX=8

DOCUMENT_STORAGE_PATH=/data/documents
EMBEDDING_CACHE_PATH=/data/models
EMBEDDING_ALLOW_DOWNLOAD=false
PRODUCTION_PLANS_FILE=/run/secrets/plans.json

BACKGROUND_JOB_SCHEMA=student_jobs
BACKGROUND_JOB_WORKER_CONCURRENCY=4
BACKGROUND_JOB_SCHEDULE_ENABLED=true

LOG_LEVEL=info
OPERATIONS_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
ERROR_MONITORING_ENABLED=true
SENTRY_DSN=https://REPLACE_PUBLIC_KEY@REPLACE_INGEST_HOST/REPLACE_PROJECT_ID

SIGNUP_ENABLED=true
SIGNUP_EMAIL_ALLOWLIST=beta-tester@example.com
OPENAI_API_KEY=REPLACE_WITH_STAGING_OPENAI_API_KEY
AI_EVAL_SAMPLING_ENABLED=false

BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
BILLING_ENVIRONMENT=staging
BILLING_MODE=test

# Global entitlement vetoes keep optional providers and Career unavailable even
# though the shared plan catalog contains their normal entitlements.
ENTITLEMENT_FEATURE_FLAGS_JSON={"integration.calendar":false,"integration.drive":false,"integration.lms":false,"ai.career":false,"workflow.career-preparation":false}
# Document embeddings are required. Disable only optional response evaluation.
AI_GUARDRAILS_JSON={"disabledFeatures":["evaluate-ai-response"]}

BETA_MODE=true
BETA_DEFAULT_COHORT=core
BETA_ADMIN_USER_IDS=
BETA_INTERNAL_USER_IDS=

PRODUCT_ANALYTICS_ENABLED=false
PRODUCT_ANALYTICS_PROVIDER=database
PRODUCT_ANALYTICS_RETENTION_DAYS=180

# Intentionally omitted for the first staging deployment:
# GOOGLE_INTEGRATION_CLIENT_ID
# GOOGLE_INTEGRATION_CLIENT_SECRET
# INTEGRATION_TOKEN_KEYS
# INTEGRATION_TOKEN_ACTIVE_KEY_ID
# STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
# STRIPE_PORTAL_CONFIGURATION_ID
# BILLING_PRICES_JSON
