# Copy OUTSIDE the checkout to an access-controlled directory. Never commit the
# filled file. runtime.env is mounted as a Compose secret and loaded server-side.
APP_ENV=staging
APP_URL=https://staging.example.com
BETTER_AUTH_URL=https://staging.example.com
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SECRET
DATABASE_URL=postgresql://agency_app:REPLACE_WITH_APP_PASSWORD@postgres:5432/agency
DATABASE_POOL_MAX=8
DOCUMENT_STORAGE_PATH=/data/documents
EMBEDDING_CACHE_PATH=/data/models
EMBEDDING_ALLOW_DOWNLOAD=false
PRODUCTION_PLANS_FILE=/run/secrets/plans.json
BACKGROUND_JOB_SCHEMA=student_jobs
BACKGROUND_JOB_WORKER_CONCURRENCY=4
BACKGROUND_JOB_SCHEDULE_ENABLED=true
LOG_LEVEL=info
OPERATIONS_TOKEN=REPLACE_WITH_RANDOM_OPERATIONS_SECRET
ERROR_MONITORING_ENABLED=true
SENTRY_DSN=https://REPLACE_PUBLIC_KEY@REPLACE_INGEST_HOST/REPLACE_PROJECT_ID
SIGNUP_ENABLED=true
SIGNUP_EMAIL_ALLOWLIST=beta-tester@example.com
OPENAI_API_KEY=REPLACE_WITH_ENVIRONMENT_SCOPED_API_KEY
AI_EVAL_SAMPLING_ENABLED=false
BILLING_ENABLED=false
BILLING_CHECKOUT_ENABLED=false
BILLING_ENVIRONMENT=staging
BILLING_MODE=test
ENTITLEMENT_FEATURE_FLAGS_JSON={"integration.calendar":false,"integration.drive":false,"integration.lms":false,"ai.career":false}
# Optional Google/billing/encryption config: copy only enabled integration keys
# from .env.example. Staging and production MUST use different credentials.

# Closed beta and private product analytics (enable deliberately per environment)
BETA_MODE=false
BETA_DEFAULT_COHORT=core
BETA_ADMIN_USER_IDS=
BETA_INTERNAL_USER_IDS=
# BETA_COHORT_FLAGS_JSON={"core":{"workflow.career-preparation":false}}
PRODUCT_ANALYTICS_ENABLED=false
PRODUCT_ANALYTICS_PROVIDER=database
PRODUCT_ANALYTICS_RETENTION_DAYS=180
# PRODUCT_ACTIVATION_EVENTS_JSON=["onboarding_completed","course_created","ai_request_completed"]
# PRODUCT_MEANINGFUL_EVENTS_JSON=["ai_request_completed","quiz_completed","workflow_completed","study_task_completed"]
